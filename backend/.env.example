# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4001

# Comma-separated list of browser origins allowed to call this API.
# Must NOT reference localhost when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Secrets (REQUIRED) ------------------------------------------------------
# The server refuses to start unless both are set, differ, are at least 32
# characters, and are not one of the historical development placeholders.
# Generate them with:  npm run secrets:generate -- --write
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor for password hashing. 10-15; 12 is a good default.
BCRYPT_ROUNDS=12

# ---- Database ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=school_management

# Required for most managed providers (Supabase, Neon, RDS, Cloud SQL).
DB_SSL=false
DB_CONNECT_TIMEOUT_MS=5000
DB_LOGGING=false

# Schema synchronize can DROP and recreate tables. Ignored when NODE_ENV=production
# and rejected outright if you try to enable it there.
DB_SYNCHRONIZE=false

# Applies pending migrations on boot. Defaults to true in production.
DB_MIGRATIONS_RUN=true

# Escape hatch: boot on a throwaway in-memory SQLite database when Postgres is
# unreachable. Every restart destroys all data. Ignored in production, which
# fails to start instead.
ALLOW_SQLITE_FALLBACK=false